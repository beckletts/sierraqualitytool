# Sierra Admin API (Read scope, redacted transcripts)
SIERRA_API_BASE_URL=https://api.eu.sierra.ai
SIERRA_API_TOKEN=
SIERRA_ORG_ID=
SIERRA_AGENT_ID=

# Anthropic (Claude) API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# Cookie platform's PostgreSQL database (same one the overwatch-qa app uses).
# Get this from the Cookie portal's Config tab for the overwatch-qa app.
DATABASE_URL=

# Old Supabase project's direct Postgres connection string (Supabase dashboard
# -> Settings -> Database -> Connection string). Only needed to run
# `npm run migrate:supabase`, the one-off historical-data migration into
# DATABASE_URL above — not needed for normal worker pulls.
SUPABASE_DB_URL=
