# Sierra Admin API (Read scope, redacted transcripts)
#
# Each Sierra agent has its own token, and agents may sit in different Sierra
# environments. The non-secret routing details (agent ID, org, base URL) live in
# the `agents` table, editable on the Settings page. Each row names the env var
# its token comes from — add one variable here per agent, matching that name.
#
# Example, for an agent row with token_env_var = SIERRA_TOKEN_SUPPORT:
# SIERRA_TOKEN_SUPPORT=

# Anthropic (Claude) API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# Cookie platform's PostgreSQL database (same one the overwatch-qa app uses).
# Get this from the Cookie portal's Config tab for the overwatch-qa app.
DATABASE_URL=

# Salesforce Knowledge (read-only).
#
# support.pearson.com is Salesforce Knowledge behind an Experience Cloud front
# end, so its /s/article/ pages are a JavaScript app with no article text in the
# HTML. Fetching them cannot work; reading the same content through this API
# can, and gives article IDs, versions and publish dates as a bonus.
#
# What to ask OCTO for: a connected app with the client-credentials flow and
# read access to Knowledge__kav. No user context, no write scope.
#
# `npm run probe` reports these as "not configured" until they are set, so the
# gap stays visible instead of being silently skipped.
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Optional; defaults to v61.0.
SALESFORCE_API_VERSION=
