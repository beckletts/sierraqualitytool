{
  // Type-checks the tests alongside the source without pulling them into the
  // build: `tsx --test` strips types rather than checking them, so without this
  // the test files would be the only unchecked code in the worker.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "test"]
}
